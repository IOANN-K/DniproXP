# Public frontend configuration only. Never put API keys, JWT secrets or passwords in VITE_*.
# API is the default. Relative /v1 requires an API reverse proxy on the frontend origin.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:3000/v1
# Production: https://api.<your-domain>/v1 or same-origin /v1 with HTTPS reverse proxy.
# Explicit local-only legacy demonstration: VITE_DATA_SOURCE=demo (forbidden in production).
