NODE_ENV=development
API_PORT=3000

# Either DATABASE_URL (postgresql://...) or all split credentials. No secrets in Git.
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5434
DB_USER=dniproxp
DB_PASSWORD=
DB_NAME=dniproxp
DB_SSL=false
# DB_SSL_CA=PEM certificate; escaped \n is supported. Production requires verified TLS.

# Generate TWO independent random secrets (at least 48 characters each).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# TTL values are integer SECONDS, not duration strings.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=dniproxp-api
JWT_AUDIENCE=dniproxp-web
CORS_ORIGINS=http://localhost:5173
# Local HTTP only. Production requires true (and HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SWAGGER_ENABLED=false
# Keep 0 unless the API is accessible ONLY through exactly this many trusted proxies.
TRUST_PROXY_HOPS=0

# Explicit development/test CLI only; never auto-run. All five pairs required.
ALLOW_DEMO_SEED=false
SEED_VOLUNTEER_EMAIL=
SEED_VOLUNTEER_PASSWORD=
SEED_VOLUNTEER_2_EMAIL=
SEED_VOLUNTEER_2_PASSWORD=
SEED_ORGANIZER_EMAIL=
SEED_ORGANIZER_PASSWORD=
SEED_ORGANIZER_2_EMAIL=
SEED_ORGANIZER_2_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# AI disabled until ALL four values are supplied. Base URL includes provider API prefix (e.g. /v1).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=15000
AI_USER_DAILY_LIMIT=10
AI_ORG_DAILY_LIMIT=50
AI_GLOBAL_DAILY_LIMIT=200
AI_CONCURRENCY_LIMIT=3
AI_MAX_SUGGESTIONS=3
# Only invalid structured output may retry; network ambiguity never retries automatically.
AI_OUTPUT_RETRIES=0
AI_RETENTION_DAYS=30
